# ─── Backend API base URL ─────────────────────────────────────────────
# In development: leave empty (Vite proxy handles /api → localhost:5000)
# In production: set to your Render backend URL (no trailing slash)
VITE_API_BASE_URL=https://studybudy-backend.onrender.com

# ─── Backend URL for WebSocket & avatar images ────────────────────────
# Same Render URL used for Socket.io connection and asset loading
VITE_BACKEND_URL=https://studybudy-backend.onrender.com
