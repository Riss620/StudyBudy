# ─── Database ────────────────────────────────────────────────────────
# MongoDB Atlas free cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/studybudy?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here

# ─── Email (Gmail App Password) ───────────────────────────────────────
# Enable 2FA on your Gmail account, then create an App Password
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# ─── Cloudinary (free tier – 25 GB storage, 25 GB bandwidth/month) ───
# Sign up at https://cloudinary.com and get these from the Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Frontend URL (used for CORS) ─────────────────────────────────────
# Set to your Vercel deployment URL once deployed
FRONTEND_URL=https://your-app.vercel.app

# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
